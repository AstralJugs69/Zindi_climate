# Repository used by bootstrap/update/sync. Store the real value as a Kaggle
# environment variable or pass --repo-url to bootstrap_kaggle.py.
CRHP_REPO_URL=https://github.com/AstralJugs69/Zindi_climate.git
CRHP_BRANCH=main

# Optional: private Kaggle Dataset used to persist models/submissions/run state.
# Example: your-kaggle-username/climate-risk-health-checkpoints
CRHP_ARTIFACT_DATASET=

# Optional GitHub Personal Access Token for a private repo or pushes.
# Add this as a Kaggle Secret named GITHUB_TOKEN. Never commit the token.
GITHUB_TOKEN=
